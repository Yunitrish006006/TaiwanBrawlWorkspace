      "id": "frontend-native-resource-storage-integration",
      "repository": "taiwan-brawl-front",
      "requiredFor": [
        "game-module-change",
        "contract-change"
      ],
      "commands": [
        "flutter test integration_test/game_resource_native_lifecycle_test.dart -d <Android-emulator-id>",
        "flutter test integration_test/game_resource_native_lifecycle_test.dart -d <iOS-simulator-id>"
      ],
      "notes": "Requires Android Emulator or iOS Simulator and the integration_test Flutter SDK package. Using Hive platform storage and injected HTTP/signature fixtures, the test installs v1, forces update migration failure and verifies v1 rollback, installs v2, closes/reopens Hive and verifies selected module plus installed bytes/version, then removes the resource while keeping the module enabled."
    },
